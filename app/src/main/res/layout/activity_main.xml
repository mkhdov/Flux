<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/main_month_toggle"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple_rect"
            android:contentDescription="@string/month_view"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/main_month_title"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"
            android:textColor="@color/accent"
            android:textSize="20sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/main_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/search"
            android:padding="11dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />

        <FrameLayout
            android:id="@+id/main_sync_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/main_sync_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/sync_status"
                android:src="@drawable/ic_cloud"
                app:tint="@color/text_secondary" />

            <View
                android:id="@+id/main_sync_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="11dp"
                android:background="@drawable/bg_color_dot"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/main_add_event"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/new_event"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            app:tint="@color/accent" />
    </LinearLayout>

    <com.mkhdov.flux.ui.calendar.WeekStripView
        android:id="@+id/main_week_strip"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/main_day_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/main_sync_label"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/bg_sync_pill"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/synced"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/main_day_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/main_month_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:overScrollMode="never"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/main_loading"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_bottom_today"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/today"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp"
            app:icon="@drawable/ic_today"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="18dp"
            app:iconTint="@color/accent"
            app:rippleColor="@color/accent_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_bottom_calendars"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/calendars"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="18dp"
            app:iconTint="@color/accent"
            app:rippleColor="@color/accent_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_bottom_inbox"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/inbox"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp"
            app:icon="@drawable/ic_list"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="18dp"
            app:iconTint="@color/accent"
            app:rippleColor="@color/accent_soft" />
    </LinearLayout>
</LinearLayout>
